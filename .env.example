# Albers Aerospace Intranet - Environment Configuration
# For Dokku Internal Deployment

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string (automatically set by Dokku postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# Session Security
# ============================================
# Secret key for encrypting session data
# Generate a secure random string: openssl rand -base64 32
SESSION_SECRET=your-secure-random-session-secret-here

# ============================================
# SMTP Email Configuration (Outlook Gov)
# ============================================
# SMTP server hostname
SMTP_HOST=smtp.office365.us

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Outlook Gov email address for sending emails
SMTP_USER=your-email@albers.aero

# Outlook Gov email password or app-specific password
SMTP_PASS=your-email-password

# From email address (usually same as SMTP_USER)
SMTP_FROM=your-email@albers.aero

# ============================================
# Application Configuration
# ============================================
# Node environment (production recommended)
NODE_ENV=production

# Port for the web server (Dokku handles this automatically)
PORT=5000

# Base URL for the application (used in emails and links)
# Set to your application's URL
BASE_URL=https://intranet.albers.aero

# ============================================
# File Storage Configuration
# ============================================
# Directory for local file storage (Dokku volume mount)
# Default: /app/storage
STORAGE_DIR=/app/storage

# ============================================
# Disabled Features (Do Not Set)
# ============================================
# The following features are disabled for internal deployment:
# - AI_INTEGRATIONS_OPENAI_BASE_URL (OpenAI API - Albers Bot disabled)
# - AI_INTEGRATIONS_OPENAI_API_KEY (OpenAI API - AI scoring disabled)
# - CLICKUP_API_KEY (ClickUp integration disabled)
# - JWT_SECRET (SSO to BI Tool disabled)
# - BI_APP_URL (SSO to BI Tool disabled)
# - AGENTMAIL_API_KEY (Email ingestion disabled)
# - GOOGLE_CLOUD_* (Google Cloud Storage - using local storage)
# - RESEND_API_KEY (Resend email - using SMTP)
# - REPLIT_* (Replit platform services - not applicable)
