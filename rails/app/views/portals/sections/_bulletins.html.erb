<%# DivisionBulletins.tsx — bulletin list or the "No bulletins yet." empty
    state. items: published Bulletin content items. %>
<%
  title = section.locals[:title]
  limit = section.locals[:limit]
  bulletins = items.select { |i| i.content_record_type == "Bulletin" }.first(limit)
%>
<div class="shadcn-card rounded-xl border bg-card border-card-border text-card-foreground shadow-sm">
  <div class="flex flex-col space-y-1.5 p-6 pb-4">
    <div class="flex items-center gap-2">
      <%= lucide_icon("megaphone", css: "w-5 h-5 text-primary") %>
      <div class="text-2xl font-semibold leading-none tracking-tight"><%= title %></div>
    </div>
  </div>
  <div class="p-6 pt-0">
    <% if bulletins.empty? %>
      <div class="text-center py-8 text-muted-foreground">
        <%= lucide_icon("megaphone", css: "w-12 h-12 mx-auto mb-3 opacity-50") %>
        <p class="text-sm">No bulletins yet.</p>
      </div>
    <% else %>
      <div class="space-y-4">
        <% bulletins.each do |item| %>
          <article class="p-4 border rounded-lg hover-elevate">
            <div class="flex items-start justify-between gap-2 mb-2">
              <h3 class="font-semibold text-foreground flex items-center gap-2">
                <% if item.content_record.is_pinned? %>
                  <%= lucide_icon("pin", css: "w-4 h-4 text-primary") %>
                <% end %>
                <%= item.title %>
              </h3>
              <% if item.content_record.is_pinned? %>
                <div class="whitespace-nowrap inline-flex items-center rounded-md border px-2.5 py-0.5 font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 hover-elevate border-transparent bg-secondary text-secondary-foreground text-xs shrink-0">Pinned</div>
              <% end %>
            </div>
            <p class="text-muted-foreground text-sm mb-2"><%= item.content_record.body&.to_plain_text %></p>
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
              <% if item.author&.display_name.present? %>
                <span>By <%= item.author.display_name %></span>
              <% end %>
              <span>•</span>
              <span><%= (item.publish_at || item.created_at).strftime("%b %-d, %Y") %></span>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
