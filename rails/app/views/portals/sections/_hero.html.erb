<%# Hero banner — one template for all divisions (the Node pages copy-pasted
    this block; only image/gradient/icon/copy differ, carried by Portal::Hero).
    A published HeroAsset content item overrides title/subtitle/background. %>
<%
  bg_url = if override&.image&.attached?
    url_for(override.image)
  else
    image_url(hero.image)
  end
  title = override&.title.presence || hero.title
  subtitle = override&.subtitle.presence || hero.subtitle
%>
<div class="relative overflow-hidden rounded-lg shadow-lg">
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url(<%= bg_url %>)"></div>
  <div class="absolute inset-0 <%= hero.gradient %>"></div>

  <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-32 translate-x-32"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-24 -translate-x-24"></div>
  <div class="absolute top-1/2 right-1/4 w-2 h-2 bg-white/20 rounded-full animate-pulse"></div>
  <div class="absolute top-1/3 right-1/3 w-1.5 h-1.5 bg-white/15 rounded-full animate-pulse delay-300"></div>
  <div class="absolute bottom-1/3 right-1/2 w-1 h-1 bg-white/10 rounded-full animate-pulse delay-700"></div>

  <div class="relative z-10 p-8">
    <div class="flex items-start gap-5 mb-6">
      <div class="relative">
        <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 shadow-lg">
          <%= lucide_icon(hero.icon, css: "w-8 h-8 text-white") %>
        </div>
        <div class="absolute -top-1 -right-1 w-3 h-3 rounded-full border-2 animate-pulse <%= hero.dot_css %>"></div>
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2">
          <div class="whitespace-nowrap inline-flex items-center rounded-md border px-2.5 py-0.5 transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 hover-elevate shadow-xs bg-white/20 text-white border-white/30 text-xs font-medium">
            <%= hero.badge %>
          </div>
        </div>
        <h1 class="text-3xl font-bold text-white mb-2 tracking-tight">
          <%= title %>
        </h1>
        <p class="text-lg text-white/80">
          <%= subtitle %>
        </p>
      </div>
    </div>

    <p class="text-white/70 mb-6 leading-relaxed">
      <%= hero.description %>
    </p>

    <div class="bg-white/10 backdrop-blur-sm rounded-lg p-1 border border-white/20">
      <%# Node's InlineSearch input, transcribed; submits to the portal's own
          server-side search instead of the client-side index. %>
      <form action="<%= portal_path(division: division) %>" method="get" class="relative w-full">
        <div class="relative">
          <%= lucide_icon("search", css: "absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground") %>
          <input type="text" name="q" placeholder="Search or Ask Albers Bot..."
                 class="flex w-full rounded-md border border-input px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm pl-10 h-10 bg-background">
        </div>
      </form>
    </div>

    <div class="flex flex-wrap gap-6 mt-6 pt-6 border-t border-white/10">
      <% hero.stats.each do |stat| %>
        <% case stat.kind %>
        <% when :dot %>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full <%= stat.css %>"></div>
            <span class="text-white/60 text-sm"><%= stat.label %></span>
          </div>
        <% when :icon %>
          <div class="flex items-center gap-2">
            <%= lucide_icon(stat.icon, css: "w-4 h-4 text-white/60") %>
            <span class="text-white/60 text-sm"><%= stat.label %></span>
          </div>
        <% when :link %>
          <a href="<%= stat.href %>">
            <div class="flex items-center gap-2 hover:text-white/80 cursor-pointer">
              <%= lucide_icon(stat.icon, css: "w-4 h-4 text-white/60") %>
              <span class="text-white/60 text-sm"><%= stat.label %></span>
            </div>
          </a>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
