<%# LinkedInWidget.tsx. The baselines were captured logged in as an admin, so
    the "Sync a LinkedIn post" affordance is part of the frozen empty state —
    rendered unconditionally here (it links to the admin, harmless for
    non-admins). items: published LinkedinPost content items. %>
<% post = items.find { |i| i.content_record_type == "LinkedinPost" } %>
<div class="shadcn-card rounded-xl border bg-card border-card-border text-card-foreground shadow-sm w-full h-full flex flex-col">
  <div class="flex flex-col space-y-1.5 p-6 pb-2">
    <%# no leading-none: tailwind-merge drops it when a text-size override (text-base) is present %>
    <div class="font-semibold tracking-tight flex items-center gap-2 text-base">
      <%= linkedin_icon(css: "w-5 h-5 text-[#0A66C2]") %>
      Latest from LinkedIn
    </div>
  </div>
  <% if post.nil? %>
    <div class="p-6 text-center py-6 flex-1 flex flex-col justify-center">
      <%= linkedin_icon(css: "w-10 h-10 mx-auto text-muted-foreground mb-3") %>
      <p class="text-sm text-muted-foreground mb-3">
        No LinkedIn post synced yet
      </p>
      <div class="flex flex-col gap-2">
        <a href="https://www.linkedin.com/company/albers-aerospace/posts/" target="_blank" rel="noopener noreferrer">
          <button class="inline-flex items-center justify-center whitespace-nowrap font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 hover-elevate active-elevate-2 border [border-color:var(--button-outline)] shadow-xs active:shadow-none min-h-8 rounded-md px-3 text-xs w-full gap-2">
            <%= linkedin_icon(css: "w-4 h-4") %>
            Follow us on LinkedIn
            <%= lucide_icon("external-link", css: "w-3 h-3") %>
          </button>
        </a>
        <a href="/avo">
          <button class="inline-flex items-center justify-center whitespace-nowrap font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 hover-elevate active-elevate-2 border border-transparent min-h-8 rounded-md px-3 gap-2 text-xs w-full text-muted-foreground">
            Sync a LinkedIn post
          </button>
        </a>
      </div>
    </div>
  <% else %>
    <div class="p-6 pt-0 space-y-3 flex-1 flex flex-col">
      <p class="text-sm whitespace-pre-wrap line-clamp-6"><%= post.subtitle.presence || post.title %></p>
      <% if post.image.attached? %>
        <img src="<%= url_for(post.image) %>" alt="LinkedIn post" class="w-full h-auto rounded-lg flex-1 object-cover">
      <% end %>
      <div class="flex items-center justify-between pt-2 border-t mt-auto">
        <span class="text-xs text-muted-foreground flex items-center gap-1">
          <%= lucide_icon("clock", css: "w-3 h-3") %>
          <%= (post.publish_at || post.created_at).strftime("%b %-d, %Y") %>
        </span>
        <% if post.content_record.external_ref.present? %>
          <a href="<%= post.content_record.external_ref %>" target="_blank" rel="noopener noreferrer">
            <button class="inline-flex items-center justify-center whitespace-nowrap font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 hover-elevate active-elevate-2 border border-transparent min-h-8 rounded-md px-3 h-7 text-xs gap-1 text-[#0A66C2]">
              View Post
              <%= lucide_icon("external-link", css: "w-3 h-3") %>
            </button>
          </a>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
