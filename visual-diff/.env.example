# Copy to .env and fill in. Local dev credentials only — never real ones.

# Where the two apps are running locally.
OLD_APP_URL=http://127.0.0.1:5050
NEW_APP_URL=http://127.0.0.1:4123

# A logged-in Node account, needed to capture baselines for the four
# division portals that sit behind auth (corporate is public and needs no
# login). See rails/README.md's dev-login section for the Rails-side
# equivalent — the Rails compare step needs no auth since portal routes are
# public there.
OLD_APP_EMAIL=dev@albers.aero
OLD_APP_PASSWORD=devpassword123
